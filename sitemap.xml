---
layout: null
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for page in site.pages %}
  {%- if page.sitemap == false or page.url contains '404' or page.url contains '.json' or page.url contains '.xml' or page.url contains '.css' or page.url contains '.js' or page.url contains '/assets/' %}{% continue %}{% endif %}
  {%- unless page.url contains '.html' or page.url == '/' or page.url contains '/' %}{% continue %}{% endunless %}
  <url><loc>{{ page.url | absolute_url | xml_escape }}</loc></url>
{%- endfor %}
{%- for work in site.works %}
  <url><loc>{{ work.url | absolute_url | xml_escape }}</loc></url>
{%- endfor %}
</urlset>
